module(name = "cards")

bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "rules_swift", version = "4.1.0")
bazel_dep(name = "rules_apple", version = "5.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.24.1")

# Xcode 27 requires TMPDIR to be absolute. rules_swift 4.1.0 passes its
# macro-expansion directory to the Swift worker as an execroot-relative path.
single_version_override(
    module_name = "rules_swift",
    patches = ["//patches:rules_swift-xcode27-tmpdir.patch"],
    patch_strip = 1,
    version = "4.1.0",
)

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_cardscore", "swiftpkg_cardsfeatures", "swiftpkg_cardsscanner", "swiftpkg_cardsui", "swiftpkg_rsbarcodes_swift")
