# Xcode
# The project is checked in: track project.pbxproj, the shared scheme and the
# SPM pin, but never per-user state. Each intermediate directory needs its own
# un-ignore because git will not descend into an excluded directory.
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/xcschemes/
!*.xcodeproj/xcshareddata/xcbaselines/
!*.xcodeproj/project.xcworkspace/
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/README.md
fastlane/derived_data/

# Ruby
Gemfile.lock
vendor/

# Certificates
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

# Build artifacts
*.ipa
*.dSYM.zip
*.app

# macOS
.DS_Store
fastlane/.env

# Swift Package Manager
.build/
**/.swiftpm/

# Signing
Cards.mobileprovision

# Build output (xcodebuild derived data and archives)
build/

# Coverage
.coverage-stash/
coverage-html/

# Kiro task notes (local only)
.kiro/
