# Xcode
# The project is checked in: track project.pbxproj, the shared scheme and the
# SPM pin, but never per-user state. Each intermediate directory needs its own
# un-ignore because git will not descend into an excluded directory.
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/xcschemes/
!*.xcodeproj/xcshareddata/xcbaselines/
!*.xcodeproj/project.xcworkspace/
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/

# Xcode build output. Fastlane is no longer used, but this Mac's Xcode has a
# custom build location (Settings > Locations > Advanced: relative to the
# workspace, fastlane/derived_data/Build/Products) set for other projects, so
# every build of Cards writes here. Safe to delete; the next build recreates it.
fastlane/derived_data/

# Certificates
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

# Build artifacts
*.ipa
*.dSYM.zip
*.app

# macOS
.DS_Store

# Swift Package Manager
.build/
**/.swiftpm/

# Signing
Cards.mobileprovision

# Build output (xcodebuild derived data and archives)
build/

# Coverage
coverage-html/

# Claude Code: worktrees and personal settings stay local; .claude/settings.json and .claude/skills are shared.
.claude/worktrees/
.claude/settings.local.json
