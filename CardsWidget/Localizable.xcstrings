    "Add a card in Card Barcodes and it shows here." : {
      "comment" : "Under “No cards yet” in the Home Screen widget. Card Barcodes is the app's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بطاقة في Card Barcodes وستظهر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in Card Barcodes eine Karte hinzu, dann erscheint sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una tarjeta en Card Barcodes y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une carte dans Card Barcodes et elle apparaîtra ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una carta in Card Barcodes e apparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodesで追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodes에서 카드를 추가하면 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um cartão no Card Barcodes e ele aparecerá aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Card Barcodes 中添加卡片后将显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Card Barcodes 中加入卡片後會顯示在這裡。"
          }
        }
      }
    },
