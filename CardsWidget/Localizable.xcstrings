{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A card's name in the Home Screen widget's settings, exactly as the user typed it. Never translated.",
      "shouldTranslate" : false
    },
    "%@ · %@" : {
      "comment" : "On a card's screen: the distance to the card's nearest location, then the place's name, as in “350 m · Boulder Barn”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "en" : {
