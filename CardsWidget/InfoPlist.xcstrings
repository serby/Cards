    "CFBundleName" : {
      "comment" : "The widget extension's product name, CardsWidget. iOS names the widget by its display name, so this stays as it is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CardsWidget"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Shown by iOS when the Home Screen widget first asks for the user's location. Explains that the widget uses it to show the card for the place where the user is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح موقعك للأداة عرض بطاقة المكان الذي أنت فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird verwendet, um im Widget die Karte für den Ort anzuzeigen, an dem du gerade bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location lets the widget show the card for the place you are at."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para que el widget muestre la tarjeta del lugar en el que estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position permet au widget d’afficher la carte du lieu où vous vous trouvez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione viene usata per mostrare nel widget la carta del luogo in cui ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今いる場所のカードをウィジェットに表示するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯이 사용자가 있는 장소의 카드를 표시할 수 있도록 위치를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização é usada para mostrar no widget o cartão do lugar onde você está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的位置用于让小组件显示你所在地点的卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的位置可讓小工具顯示你所在地點的卡片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
