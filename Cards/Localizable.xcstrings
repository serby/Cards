{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "On a card's screen: the distance to the card's nearest location, then the place's name, as in “350 m · Westway”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "The app's version and then its build number, as in “1.1 (42)”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ from %@" : {
      "comment" : "VoiceOver label: how far the user is from a card's nearest location, as in “350 m from Westway”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ from %2$@"
          }
        }
      }
    },
    "%@ radius" : {
      "comment" : "Under a location's name in the card form: the size of the circle around the place, as in “200 m radius”."
    },
    "%@, %@ radius" : {
      "comment" : "VoiceOver value of the pin on the Add Location map: the name the place will get, then the circle's size, as in “Westway, 200 m radius”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ radius"
          }
        }
      }
    },
    "Add" : {
      "comment" : "Toolbar button that adds the place under the map pin to the card. A verb."
    },
    "Add Card" : {
      "comment" : "Button on the empty card list that opens the form for a new card.\nTitle of the form for adding a new card.\nVoiceOver label for the toolbar button, a barcode scanner icon, that adds a new card."
    },
    "Add Location" : {
      "comment" : "Button in the card form that opens a map for adding a place where the card is used.\nTitle of the map sheet for adding a place where a card is used."
    },
    "At %@" : {
      "comment" : "On a card's screen when the user is inside one of the card's locations. The argument is the place's name, such as Westway."
    },
    "Aztec" : {
      "comment" : "Barcode format in the barcode type picker: the square 2D Aztec Code. Keep it unless your language writes it differently."
    },
    "Barcode" : {
      "comment" : "VoiceOver label for the barcode on a card's screen. Its format, such as EAN-13, is read after it."
    },
    "Barcode scanner" : {
      "comment" : "VoiceOver label for the live camera view at the top of the new card form."
    },
    "Barcode Type" : {
      "comment" : "Label of the menu for choosing the card's barcode format, such as EAN-13 or QR Code."
    },
    "Blue" : {
      "comment" : "Card colour name read by VoiceOver in the colour picker."
    },
    "Boosts brightness when viewing card to improve scannability" : {
      "comment" : "Explains the Brightness Boost switch above it in Settings."
    },
    "Brightness" : {
      "comment" : "A name Voice Control users can say for the Brightness Boost button on a card's screen."
    },
    "Brightness Boost" : {
      "comment" : "Settings switch for the feature that turns the screen up while a card is shown, so scanners can read its barcode.\nVoiceOver label for the sun button on a card's screen, which turns the screen up so scanners can read the barcode."
    },
    "Brightness boost off" : {
      "comment" : "VoiceOver announcement after the sun button turns Brightness Boost off."
    },
    "Brightness boost on" : {
      "comment" : "VoiceOver announcement after the sun button turns Brightness Boost on."
    },
    "Brown" : {
      "comment" : "Card colour name read by VoiceOver in the colour picker."
    },
