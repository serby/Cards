{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "On a card's screen: the distance to the card's nearest location, then the place's name, as in “350 m · Boulder Barn”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "The app's version and then its build number, as in “1.1 (42)”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Joins two sentences of the import result alert, as in “Imported 3 cards. 1 was already in Card Barcodes.” The first argument is the result so far, the second the sentence that follows it. A language that writes sentences without a space between them, such as Japanese or Chinese, leaves the space out.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ from %@" : {
      "comment" : "VoiceOver label: how far the user is from a card's nearest location, in full, as in “350 metres from Boulder Barn”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@ entfernt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ from %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ de %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@から%1$@"
          }
        }
      }
    },
    "%@ radius" : {
      "comment" : "Under a location's name in the card form: the size of the circle around the place, as in “200 m radius”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radius: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio de %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半径%@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Name given to a place picked on the map from its street and then its district or town, as in “Portobello Road, Notting Hill”. Use your language's order and separator for the two.\nVoiceOver label for a card's tile on the Cards tab: the card's name, then how far away its nearest place is, as in “Joe's Market, 350 metres from Joe's Market Notting Hill”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ radius" : {
      "comment" : "VoiceOver label for a place: its name, then the size of the circle around it, as in “Boulder Barn, 200 metres radius”. Read for a place in the card form and for the pin on the Add Location map.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, Radius %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ radius"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, radio de %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、半径%2$@"
          }
        }
      }
    },
    "%lld barcodes found. Choose the one for this card." : {
      "comment" : "Under the list of barcodes found in a photo or a file, when there are several to choose from. The argument is how many, usually two or more.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld barcode found. Choose the one for this card."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld barcodes found. Choose the one for this card."
                }
              }
            }
          }
        }
      }
    },
    "%lld more places" : {
      "comment" : "Below the places listed on a card's screen: how many more the card has. The argument is one or more.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more place"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more places"
                }
              }
            }
          }
        }
      }
    },
    "%lld were already in Card Barcodes." : {
      "comment" : "Import result alert, after “Imported 3 cards.” or “No cards imported.”: how many cards were left out because a card with the same code is already in the app. Card Barcodes is the app's name. The argument is that number, always at least one.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld was already in Card Barcodes."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld were already in Card Barcodes."
                }
              }
            }
          }
        }
      }
    },
    "%lld were in the file more than once." : {
      "comment" : "Import result alert, after “Imported 3 cards.” or “No cards imported.”: how many cards were left out because a card with the same code came earlier in the same export, pasted or chosen as a file. The argument is that number, always at least one.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld was in the file more than once."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld were in the file more than once."
                }
              }
            }
          }
        }
      }
    },
    "%lld were missing a name or code." : {
      "comment" : "Import result alert, after “Imported 3 cards.” or “No cards imported.”: how many cards were left out because they had no name or no code. The argument is that number, always at least one.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld was missing a name or code."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld were missing a name or code."
                }
              }
            }
          }
        }
      }
    },
    "Add" : {
      "comment" : "Toolbar button that adds the place under the map pin to the card. A verb.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加"
          }
        }
      }
    },
    "Add a card in Card Barcodes and it shows here." : {
      "comment" : "Under “No cards yet” in the Home Screen widget. Card Barcodes is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in Card Barcodes eine Karte hinzu, dann erscheint sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una tarjeta en Card Barcodes y aparecerá aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodesで追加できます。"
          }
        }
      }
    },
    "Add a place to be reminded when you arrive there." : {
      "comment" : "Footer under the Locations section of the card form while the card has no places."
    },
    "Add Card" : {
      "comment" : "Button at the bottom of the sheet for a card someone shared, which adds the card to the list.\nButton on the empty card list that opens the form for a new card.\nTitle of the form for adding a new card.\nVoiceOver label for the toolbar button, a barcode scanner icon, that adds a new card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir tarjeta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを追加"
          }
        }
      }
    },
    "Add Card?" : {
      "comment" : "Title of the sheet that opens from a link to a card someone shared, asking whether to add it."
    },
    "Add current location" : {
      "comment" : "Button below a card on its screen: opens a map to save a place for it."
    },
    "Add Location" : {
      "comment" : "Button in the card form that opens a map for adding a place where the card is used.\nTitle of the map sheet for adding a place where a card is used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuer Ort"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir ubicación"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所を追加"
          }
        }
      }
    },
    "Added %@" : {
      "comment" : "VoiceOver announcement after a place is added to the card in the card form. The argument is the place's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hinzugefügt"
          }
