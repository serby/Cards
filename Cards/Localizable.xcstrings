    "When you arrive at one of these places, the barcode appears on your Lock Screen." : {
      "comment" : "Footer under the card's places in the card form, explaining the arrival notification.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند وصولك إلى أحد هذه الأماكن، يظهر الرمز الشريطي على شاشة القفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du an einem dieser Orte ankommst, erscheint der Barcode auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llegues a uno de estos lugares, el código de barras aparecerá en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous arrivez à l’un de ces lieux, le code-barres s’affiche sur votre écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando arrivi in uno di questi luoghi, il codice a barre appare sulla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの場所に到着すると、バーコードがロック画面に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 장소 중 한 곳에 도착하면 바코드가 잠금 화면에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você chegar a um desses lugares, o código de barras aparecerá na sua Tela Bloqueada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
