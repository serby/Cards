    "Imported %lld cards." : {
      "comment" : "Import result alert after cards are added from an export, pasted or chosen as a file. The argument is how many cards were added, always at least one. Sentences about cards left out may follow it.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
