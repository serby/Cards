    "Camera access is off. Type the code below, or allow camera access in Settings." : {
      "comment" : "Shown over the black camera view at the top of the new card form when the app may not use the camera.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الكاميرا مُعطّل. اكتب الرمز أدناه، أو اسمح بالوصول إلى الكاميرا في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist deaktiviert. Gib den Code unten ein oder erlaube den Kamerazugriff in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Escribe el código abajo o permite el acceso a la cámara en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à l’appareil photo est désactivé. Saisissez le code ci-dessous ou autorisez l’accès dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla fotocamera è disattivato. Inserisci il codice qui sotto oppure consenti l'accesso alla fotocamera in Impostazioni."
