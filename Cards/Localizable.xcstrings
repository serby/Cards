            "value" : "Este enlace no contiene ninguna tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien ne contient pas de carte."
          }
        },
        "ja" : {
          "stringUnit" : {
