        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodesで追加できます。"
          }
        }
      }
    },
    "Add a place to be reminded when you arrive there." : {
      "comment" : "Footer under the Locations section of the card form while the card has no places.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
