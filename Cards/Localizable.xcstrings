    "This deletes your cards from iCloud. The cards on this device are kept." : {
      "comment" : "Message in the dialog that asks the user to confirm deleting their cards from iCloud.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف بطاقاتك من iCloud. وسيتم الاحتفاظ بالبطاقات الموجودة على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht deine Karten aus iCloud. Die Karten auf diesem Gerät bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina tus tarjetas de iCloud. Las tarjetas de este dispositivo se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime vos cartes d’iCloud. Les cartes sur cet appareil sont conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudからカードを削除します。このデバイス上のカードは残ります。"
          }
        }
      }
    },
    "This link doesn't contain a card." : {
      "comment" : "In the sheet that opens from a link to a shared card, when the link is damaged or holds no card.",
      "localizations" : {
        "ar" : {
