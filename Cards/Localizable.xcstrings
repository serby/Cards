    "Card Barcodes cannot show %@ codes." : {
      "comment" : "Under Choose Photo and Choose File in the new card form, and read by VoiceOver, when the photo or file has only kinds of barcode the app cannot draw. The argument is their standard names joined by “or”, as in “Data Matrix or ITF-14”. Card Barcodes is the app's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر على Card Barcodes عرض رموز %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodes kann Barcodes vom Typ %@ nicht anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card Barcodes no puede mostrar códigos %@."
          }
