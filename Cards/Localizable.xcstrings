      "comment" : "Card icon picker, read by VoiceOver: a spanner and a screwdriver. A noun."
    },
    "Torch" : {
      "comment" : "VoiceOver label for the button over the camera view in the new card form that turns the phone's light on and off. A noun."
    },
    "Train" : {
      "comment" : "Card icon picker, read by VoiceOver: a train. A noun."
    },
    "Travel" : {
      "comment" : "Heading in the card icon picker over icons for travel, cars and hotels. A noun."
    },
    "Trolley" : {
      "comment" : "Card icon picker, read by VoiceOver: a supermarket trolley, or shopping cart."
    },
    "Turn it on in Settings to scan a card, or type the code below." : {
      "comment" : "Under “Camera access is off” where the camera would be in the new card form, above the Open Settings button."
    },
    "Turns full brightness on or off, so the barcode scans easily" : {
      "comment" : "VoiceOver hint for the Brightness Boost button on a card's screen. It works both ways: on when off, off when on.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل السطوع الكامل أو يوقفه ليسهل مسح الرمز الشريطي ضوئيًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die volle Helligkeit ein oder aus, damit sich der Barcode leicht scannen lässt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el brillo máximo para que el código de barras se escanee fácilmente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive la luminosité maximale pour faciliter la lecture du code-barres"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva la luminosità massima, per far leggere facilmente il codice a barre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大の明るさのオン/オフを切り替えて、バーコードを読み取りやすくします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바코드가 잘 스캔되도록 최대 밝기를 켜거나 끕니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa ou desativa o Brilho Máximo para facilitar a leitura do código de barras"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开或关闭最高亮度，方便扫描条形码"
