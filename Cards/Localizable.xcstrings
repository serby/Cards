      }
    },
    "You already have this card." : {
      "comment" : "In the sheet for a card someone shared, above Open Card, when a card with the same code is already in the list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك هذه البطاقة بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Karte bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes esta tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà cette carte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードはすでに追加されています。"
          }
        }
      }
    },
    "You are offline. Connect to the internet to search, or drag the map to the place." : {
      "comment" : "Under the search field on the Add Location and Edit Location map when the device is offline, so it cannot search.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل بالإنترنت. اتصل بالإنترنت للبحث، أو اسحب الخريطة إلى المكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Stelle eine Internetverbindung her, um zu suchen, oder ziehe die Ansicht zum Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a internet para buscar o arrastra el mapa hasta el lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Connectez-vous à Internet pour rechercher, ou faites glisser le plan jusqu’au lieu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。検索するにはインターネットに接続するか、マップをドラッグして場所に移動してください。"
          }
        }
      }
    },
    "You're at %@" : {
      "comment" : "VoiceOver label when the user is inside one of a card's locations. The argument is the place's name, such as Boulder Barn.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت في %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist bei %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にいます"
          }
        }
      }
    },
    "You're at %@. Your barcode is ready." : {
      "comment" : "Lock Screen notification on arriving at one of a card's places, under the card's name. The argument is the place's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت في %@. رمزك الشريطي جاهز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist bei %@. Dein Barcode ist bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás en %@. Tu código de barras está listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à %@. Votre code-barres est prêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にいます。バーコードの準備ができました。"
          }
        }
      }
    },
    "Your cards are no longer in iCloud. A device that still has iCloud Sync on will upload its cards again." : {
      "comment" : "Under Delete Cards from iCloud in Settings, once the cards have been deleted from iCloud. iCloud Sync is the switch above.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد بطاقاتك في iCloud. إذا كانت مزامنة iCloud لا تزال قيد التشغيل على أحد أجهزتك، فسيحمّل بطاقاته إلى iCloud مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Karten sind nicht mehr in iCloud. Ein Gerät, auf dem die iCloud-Synchronisierung noch aktiviert ist, lädt seine Karten erneut hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tarjetas ya no están en iCloud. Un dispositivo que aún tenga activada la sincronización con iCloud volverá a subir sus tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos cartes ne sont plus dans iCloud. Un appareil où la synchronisation iCloud est encore activée enverra à nouveau ses cartes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードはiCloudから削除されました。iCloud同期がオンのままのデバイスがあると、そのカードが再度アップロードされます。"
          }
        }
      }
    },
    "Your cards could not be deleted from iCloud. Check that you're signed in to iCloud and online, then try again." : {
      "comment" : "Under Delete Cards from iCloud in Settings, when iCloud could not be reached or the user is not signed in to it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حذف بطاقاتك من iCloud. تأكد من أنك مسجّل الدخول إلى iCloud ومتصل بالإنترنت، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Karten konnten nicht aus iCloud gelöscht werden. Prüfe, ob du bei iCloud angemeldet und online bist, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido eliminar tus tarjetas de iCloud. Comprueba que has iniciado sesión en iCloud y que tienes conexión, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer vos cartes d’iCloud. Vérifiez que vous êtes connecté à iCloud et en ligne, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudからカードを削除できませんでした。iCloudにサインインしていてインターネットに接続されていることを確認して、もう一度お試しください。"
          }
        }
      }
    },
    "Your cards stay in iCloud until you delete them there." : {
      "comment" : "Under Delete Cards from iCloud in Settings, with iCloud Sync off, before anything has been deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى بطاقاتك في iCloud حتى تحذفها من هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Karten bleiben in iCloud, bis du sie dort löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tarjetas permanecen en iCloud hasta que las elimines allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos cartes restent dans iCloud jusqu’à ce que vous les y supprimiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードは、iCloudから削除するまでiCloudに残ります。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}