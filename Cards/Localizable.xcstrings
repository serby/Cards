                  "value" : "سيؤدي هذا إلى حذف البطاقتين نهائيًا. لا يمكن التراجع عن هذا الإجراء."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "سيؤدي هذا إلى حذف %lld بطاقة نهائيًا. لا يمكن التراجع عن هذا الإجراء."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
