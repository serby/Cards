    "Car" : {
      "comment" : "Card icon picker, read by VoiceOver: a car."
    },
    "Card" : {
      "comment" : "File name, before .png, of the picture of a card with no name, shared from the card's screen. A noun: one loyalty card."
    },
    "Card Barcodes cannot show %@ codes." : {
      "comment" : "Under Choose Photo and Choose File in the new card form, and read by VoiceOver, when the photo or file has only kinds of barcode the app cannot draw. The argument is their standard names joined by “or”, as in “Data Matrix or ITF-14”. Card Barcodes is the app's name."
    },
    "Card Barcodes cannot show this kind of barcode." : {
      "comment" : "Under Choose Photo and Choose File in the new card form, and read by VoiceOver, when the photo or file has only a kind of barcode the app cannot draw. Card Barcodes is the app's name."
    },
    "Card code copied" : {
      "comment" : "VoiceOver announcement after the copy button on a card's screen copies the code."
    },
