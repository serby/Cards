    "What's New" : {
      "comment" : "Settings row that opens the list of what changed in each version of the app.\nTitle of the screen, opened from Settings, that lists what each version of the app changed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما الجديد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Funktionen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novedades"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveautés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新機能"
          }
        }
      }
    },
    "When you arrive at one of these places, a notification reminds you. Tap it to open the card." : {
      "comment" : "Footer under the card's places in the card form while Notify When I Arrive is on. “It” is the notification.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند وصولك إلى أحد هذه الأماكن، سيذكّرك إشعار. اضغط عليه لفتح البطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du an einem dieser Orte ankommst, erinnert dich eine Mitteilung. Tippe darauf, um die Karte zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llegas a uno de estos lugares, una notificación te avisa. Tócala para abrir la tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous arrivez à l’un de ces lieux, une notification vous avertit. Touchez-la pour ouvrir la carte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの場所に到着すると通知でお知らせします。通知をタップするとカードが開きます。"
          }
        }
      }
    },
    "Where a card's places open when you tap one. Google Maps opens in your browser if its app isn't installed." : {
      "comment" : "Under the Maps menu in Settings. Google Maps is Google's app; use the name Google gives it in your language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق الذي تُفتح فيه أماكن البطاقة عند الضغط على أحدها. تُفتح خرائط Google في المتصفح إذا لم يكن تطبيقها مثبتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App, in der sich die Orte einer Karte öffnen, wenn du einen antippst. Google Maps öffnet sich im Browser, wenn die App nicht installiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde se abren los lugares de una tarjeta al tocar uno. Google Maps se abre en el navegador si su app no está instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine où s’ouvrent les lieux d’une carte quand vous en touchez un. Google Maps s’ouvre dans votre navigateur si son app n’est pas installée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの場所をタップしたときに開くアプリです。Google マップのアプリがない場合はブラウザで開きます。"
          }
        }
      }
    },
    "Wine glass" : {
