      }
    },
    "Add Card" : {
      "comment" : "Button at the bottom of the sheet for a card someone shared, which adds the card to the list.\nButton on the empty card list that opens the form for a new card.\nTitle of the form for adding a new card.\nVoiceOver label for the toolbar button, a barcode scanner icon, that adds a new card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
