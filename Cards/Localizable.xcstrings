    "Scan the barcode on a loyalty card to add it." : {
      "comment" : "Under “No Cards Yet” on the empty card list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز الشريطي ضوئيًا على بطاقة ولاء لإضافتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Barcode auf einer Kundenkarte, um sie hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código de barras de una tarjeta de fidelización para añadirla."
