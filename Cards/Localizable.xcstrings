    "%@ %@" : {
      "comment" : "Joins two sentences of the import result alert, as in “Imported 3 cards. 1 was already in Card Barcodes.” The first argument is the result so far, the second the sentence that follows it. A language that writes sentences without a space between them, such as Japanese or Chinese, leaves the space out.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
