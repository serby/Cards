    "Add a card in Card Barcodes and it shows here." : {
      "comment" : "Under “No cards yet” in the Home Screen widget. Card Barcodes is the app's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بطاقة في Card Barcodes وستظهر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in Card Barcodes eine Karte hinzu, dann erscheint sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una tarjeta en Card Barcodes y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une carte dans Card Barcodes et elle apparaîtra ici."
