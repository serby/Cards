    "Search is not working right now. Try again, or drag the map to the place." : {
      "comment" : "Under the search field on the Add Location and Edit Location map when Apple's map search fails or does not answer.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البحث لا يعمل حاليًا. حاول مرة أخرى أو اسحب الخريطة إلى المكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche funktioniert gerade nicht. Versuche es erneut oder ziehe die Ansicht zum Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda no funciona en este momento. Inténtalo de nuevo o arrastra el mapa hasta el lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche ne fonctionne pas pour le moment. Réessayez ou faites glisser le plan jusqu’au lieu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在検索を利用できません。もう一度お試しいただくか、マップをドラッグして場所に移動してください。"
          }
        }
      }
    },
