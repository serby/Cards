    "This will permanently delete all %lld cards. This action cannot be undone." : {
      "comment" : "Message in the delete-all dialog. The argument is how many cards there are, always at least one.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dadurch wird %lld Karte dauerhaft gelöscht. Diese Aktion kann nicht widerrufen werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dadurch werden alle %lld Karten dauerhaft gelöscht. Diese Aktion kann nicht widerrufen werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This will permanently delete %lld card. This action cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This will permanently delete all %lld cards. This action cannot be undone."
                }
              }
            }
          }
        },
        "es" : {
