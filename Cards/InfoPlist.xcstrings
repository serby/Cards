    "NSCameraUsageDescription" : {
      "comment" : "Shown by iOS when the app first asks to use the camera. Explains that the camera only scans the barcodes printed on the user's loyalty and membership cards.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الكاميرا لمسح الرموز الشريطية ضوئيًا على بطاقات الولاء والعضوية الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird verwendet, um Barcodes auf deinen Kunden- und Mitgliedskarten zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The camera is used to scan the barcodes on your loyalty and membership cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para escanear los códigos de barras de tus tarjetas de fidelización y de socio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo permet de scanner les codes-barres de vos cartes de fidélité et d’adhésion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポイントカードや会員カードのバーコードをスキャンするためにカメラを使用します。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Shown by iOS when the app first asks for the user's location. Explains the two uses: showing how far away the places are where each card is used, and a notification that reminds the user of the right card on arriving at one. It no longer promises a barcode on the Lock Screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم موقعك لإظهار مدى بُعدك عن الأماكن التي تستخدم فيها بطاقاتك، ولتذكيرك بالبطاقة المناسبة عند وصولك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird verwendet, um anzuzeigen, wie weit du von den Orten entfernt bist, an denen du deine Karten nutzt, und um dich bei deiner Ankunft an die passende Karte zu erinnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location is used to show how far you are from the places where you use your cards, and to remind you of the right card when you arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para mostrar a qué distancia estás de los lugares donde usas tus tarjetas y para recordarte la tarjeta adecuada cuando llegues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position permet d’indiquer à quelle distance se trouvent les lieux où vous utilisez vos cartes, et de vous rappeler la bonne carte à votre arrivée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを使う場所までの距離を表示したり、到着したときにその場所のカードをお知らせしたりするために、位置情報を使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Shown by iOS the first time the user saves the picture of a card they share to their photos (Save Image in the share sheet). The app only adds that picture and never reads the photo library. A full sentence ending with a full stop, as Apple writes these prompts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ صورة البطاقة التي تشاركها في صورك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild einer Karte, die du teilst, wird in deinen Fotos gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saves the picture of a card you share to your photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de la tarjeta que compartes se guarda en tus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre dans vos photos l’image d’une carte que vous partagez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有するカードの画像を写真に保存するために使用します。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}