    "NSCameraUsageDescription" : {
      "comment" : "Shown by iOS when the app first asks to use the camera. Explains that the camera only scans the barcodes printed on the user's loyalty and membership cards.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird verwendet, um Barcodes auf deinen Kunden- und Mitgliedskarten zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The camera is used to scan the barcodes on your loyalty and membership cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para escanear los códigos de barras de tus tarjetas de fidelización y de socio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポイントカードや会員カードのバーコードをスキャンするためにカメラを使用します。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Shown by iOS when the app first asks for the user's location. Explains the two uses: showing the distance to the shops where each card is used, and putting that card's barcode on the Lock Screen on arrival.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Standort wird verwendet, um die Entfernung zu den Orten anzuzeigen, an denen du deine Karten nutzt, und bei deiner Ankunft den passenden Barcode auf dem Sperrbildschirm einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location is used to show how far you are from the places where you use your cards, and to remind you of the right card when you arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu ubicación se usa para mostrar a qué distancia estás de los lugares donde usas tus tarjetas y para que el código de barras adecuado aparezca en la pantalla bloqueada cuando llegues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "カードを使う場所までの距離を表示したり、到着時にそのカードのバーコードをロック画面に表示したりするために、位置情報を使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saves the picture of a card you share to your photos."
          }
        }
      }
    }
  },
  "version" : "1.0"
}