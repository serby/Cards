  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "The app's name under its icon on the Home Screen and in Settings. Keep it short: about 12 characters fit under the icon before iOS truncates it. The app shows barcodes from loyalty and membership cards.",
