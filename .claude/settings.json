{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(swiftlint lint:*)",
      "Bash(make build:*)",
      "Bash(make test:*)",
      "Bash(make check:*)",
      "Bash(make sim:*)",
      "Bash(node scripts/generate-changelog.ts:*)",
      "Bash(node scripts/check-changelog.ts:*)",
      "Bash(node scripts/check-metadata.ts:*)",
      "Bash(node scripts/check-store-images.ts:*)",
      "Bash(node scripts/print-release-notes.ts:*)",
      "Bash(xcrun simctl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push origin v:*)",
      "Bash(gh workflow run:*)",
      "Bash(make upload-:*)",
      "Bash(make capture-screenshots:*)",
      "Bash(make store-screenshots:*)"
    ]
  }
}
